{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sortedbyus",
  // Built by @opennextjs/cloudflare (npm run deploy); don't change unless the build output changes
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sortedbyus"
    }
  ],
  // next/image optimisation via Cloudflare Images
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
