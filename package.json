{
  "name": "sortedbyus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run motion:tokens && node scripts/optimize-images.mjs && npm run build:studio",
    "dev": "next dev",
    "prebuild": "npm run motion:tokens && node scripts/optimize-images.mjs && npm run build:studio",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:studio": "sanity build public/studio -y",
    "typegen": "sanity schema extract --enforce-required-fields --path src/lib/sanity/schema.json --force && sanity typegen generate",
    "motion:harness": "vite motion/studio --open /harness.html",
    "motion:tokens": "node --experimental-strip-types --no-warnings scripts/motion-tokens.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@sanity/client": "^8.16.0",
    "@sanity/image-url": "^2.2.0",
    "groq": "^6.23.0",
    "mediabunny": "^1.66.2",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.23.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^1.11.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
