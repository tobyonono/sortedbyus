{
  "id": "card-journey",
  "name": "Card journey",
  "description": "A camera glides across a wall of request cards, stopping on each featured photo card. Loops.",
  "engine": "code",
  "cavalryScene": "Sorted-by-Us-Card-Journey.cv",
  "controls": [
    {
      "key": "stops",
      "type": "list",
      "label": "Stops",
      "group": "Featured cards",
      "max": 6,
      "item": [
        {
          "key": "image",
          "type": "image",
          "label": "Photo"
        },
        {
          "key": "label",
          "type": "text",
          "label": "Label"
        },
        {
          "key": "request",
          "type": "text",
          "label": "Request"
        }
      ]
    },
    {
      "key": "fill",
      "type": "list",
      "label": "Cards",
      "group": "Wall of requests",
      "max": 40,
      "item": [
        {
          "key": "image",
          "type": "image",
          "label": "Photo (optional)"
        },
        {
          "key": "colour",
          "type": "colour",
          "label": "Card colour"
        },
        {
          "key": "label",
          "type": "text",
          "label": "Label (optional)"
        },
        {
          "key": "request",
          "type": "text",
          "label": "Request"
        }
      ]
    },
    {
      "key": "holdSeconds",
      "type": "number",
      "label": "Hold on each card",
      "unit": "s",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "group": "Camera"
    },
    {
      "key": "spring",
      "type": "spring",
      "label": "Camera glide",
      "group": "Camera",
      "hint": "Travel time is set by the spring"
    },
    {
      "key": "zoomIn",
      "type": "number",
      "label": "Zoom on a card",
      "unit": "×",
      "min": 0.8,
      "max": 2,
      "step": 0.01,
      "group": "Camera"
    },
    {
      "key": "zoomOut",
      "type": "number",
      "label": "Zoom while travelling",
      "unit": "×",
      "min": 0.4,
      "max": 1.3,
      "step": 0.01,
      "group": "Camera"
    },
    {
      "key": "colours.background",
      "type": "colour",
      "label": "Background",
      "group": "Colour"
    },
    {
      "key": "overlayOpacity",
      "type": "number",
      "label": "Photo darken",
      "unit": "%",
      "min": 0,
      "max": 80,
      "step": 1,
      "group": "Colour"
    },
    {
      "key": "format",
      "type": "format",
      "label": "Format",
      "group": "Export"
    },
    {
      "key": "fps",
      "type": "fps",
      "label": "Frame rate",
      "group": "Export"
    }
  ],
